# syntax=docker/dockerfile:1
# Сервер: node:22-alpine + tsx server/index.ts.

FROM node:22-alpine

WORKDIR /app

# pnpm 9: в package.json нет поля packageManager, версию активируем явно
# (совпадает с pnpm-lock.yaml v9).
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml ./

# Выбор зависимостей (документированное решение): это single-package репозиторий
# без workspace, и рантайм-зависимости сервера (express, cors) лежат в
# devDependencies общего package.json — прод-обрезка (pnpm prune --prod /
# NODE_ENV=production при install) выкинула бы их и сервер не стартовал.
# Поэтому ставим всё по lockfile: pnpm install --frozen-lockfile
# (+ BuildKit cache mount для pnpm store — повторные сборки без сетевых загрузок).
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# NODE_ENV после install: иначе pnpm пропустил бы devDependencies.
ENV NODE_ENV=production

# tsx ставится pnpm в /app/node_modules/.bin, которого нет на PATH по умолчанию —
# добавляем, чтобы exec-form CMD ["tsx", ...] нашла бинарник.
ENV PATH="/app/node_modules/.bin:${PATH}"

COPY server ./server

EXPOSE 4000

CMD ["tsx", "server/index.ts"]
