# Base URL of the API server. The Vite dev server proxies /api requests here
# (see server.proxy in vite.config.ts). The API server itself lands in Task 2.
VITE_API_BASE_URL=http://localhost:4000

# Порт API-сервера (server/index.ts) и origin(ы) клиента для CORS (через запятую).
PORT=4000
CORS_ORIGIN=http://localhost:5173
