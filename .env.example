# Порт API-сервера (server/index.ts). В docker-compose nginx проксирует /api на
# http://server:4000 (nginx/default.conf) — при смене порта правьте и upstream.
PORT=4000

# Origin(ы) клиента для CORS (через запятую). Внутри docker-стека CORS не нужен:
# клиент ходит на свой же origin через nginx-прокси. Нужен для dev (vite :5173)
# и прямых обращений к серверу.
CORS_ORIGIN=http://localhost:5173

# База URL API — зарезервирована; кодом клиента сейчас не читается
# (клиент ходит на относительный /api). Прод-стек: /api проксируется nginx'ом.
VITE_API_BASE_URL=

# Порт nginx наружу на хосте (docker-compose: ${NGINX_PORT:-8080}:80).
NGINX_PORT=8080
